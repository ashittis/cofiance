# ---- Backend (FastAPI) production env ----
# Copy to  ~/cofiance/backend/.env  on the server and fill in the CHANGE_ME values.

# Local PostgreSQL on the same EC2 box (psycopg v3 driver).
DATABASE_URL="postgresql+psycopg://confiance:CHANGE_ME_DB_PASS@localhost:5432/confiance"

# Origins allowed to call the API (your live frontend). Comma-separated, no trailing slash.
CORS_ORIGINS="https://confianceservices.in,https://www.confianceservices.in"

# Shared secret the frontend sends as X-Admin-Key on /admin/* endpoints.
# MUST be identical to ADMIN_API_KEY in the frontend env.  Generate: openssl rand -hex 24
ADMIN_API_KEY="CHANGE_ME_ADMIN_KEY"

# Transactional email (optional — leave RESEND_API_KEY empty to skip emails).
# Set RESEND_API_KEY (from resend.com) to turn on all emails.
RESEND_API_KEY=""
# Before verifying a domain in Resend, keep the shared onboarding@resend.dev sender
# (it can ONLY deliver to the Resend account's own email — fine for owner alerts).
# After verifying confianceservices.in in Resend, switch to the branded sender so
# emails deliver to ANYONE (e.g. applicant confirmations):
#   RESEND_FROM="Confiance Services <noreply@confianceservices.in>"
RESEND_FROM="Confiance Services <onboarding@resend.dev>"

# Owner address that receives a notification on every Apply registration and
# Contact enquiry. Requires RESEND_API_KEY to be set; skipped if either is empty.
# Note: with an unverified Resend account you can only send to the account's own
# email, so sign up for Resend with THIS address.
NOTIFY_EMAIL="nithenramesh10@gmail.com"
