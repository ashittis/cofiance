# ---- Frontend (Next.js) production env ----
# Copy to  ~/cofiance/frontend/.env.production  on the server BEFORE running `npm run build`
# (NEXT_PUBLIC_API_URL is baked into the client bundle at build time).

# The public API, served from the api. subdomain on the same box.
NEXT_PUBLIC_API_URL="https://api.confianceservices.in"

# NextAuth (admin login).
NEXTAUTH_URL="https://confianceservices.in"
NEXTAUTH_SECRET="CHANGE_ME_run: openssl rand -base64 32"

# Admin credentials (change these from the defaults!).
ADMIN_EMAIL="you@confianceservices.in"
ADMIN_PASSWORD="CHANGE_ME_ADMIN_PASSWORD"

# MUST be the SAME value as ADMIN_API_KEY in the backend .env.
ADMIN_API_KEY="CHANGE_ME_ADMIN_KEY"
